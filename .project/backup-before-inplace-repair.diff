+async function findDamagedMetadataInFile(filePath: string) {
+  const fd = await open(filePath, 'r');
+  try {
+    const { size } = await fd.stat();
+    const read: ReadAt = async (position, length) => {
+      const buffer = new Uint8Array(length);
+      const { bytesRead } = await fd.read(buffer, 0, length, position);
+      return buffer.subarray(0, bytesRead);
+    };
+    return await findDamagedMetadataKeysBoxes(read, size);
+  } finally {
+    await fd.close();
+  }
+}
+
+/**
+ * Create a copy of a file with damaged metadata, with the damaged metadata disabled. The original file is not modified.
+ * The copy is put next to the original file if possible, otherwise in the working directory or the temp directory.
+ */
+export async function createRepairedFileCopy({ filePath, customOutDir }: { filePath: string, customOutDir: string | undefined }) {
+  const damagedBoxPositions = await findDamagedMetadataInFile(filePath);
+  if (damagedBoxPositions.length === 0) throw new UserFacingError(i18n.t('Could not find any damaged metadata to repair in this file.'));
+
+  const fileName = `${getSuffixedFileName(filePath, 'repaired')}${extname(filePath)}`;
+  const outDirs = [...new Set([dirname(filePath), ...(customOutDir != null ? [customOutDir] : []), app.getPath('temp') as string])];
+
+  let lastError: unknown;
+  for (const outDir of outDirs) {
+    const outPath = join(outDir, fileName);
+    const tmpPath = `${outPath}.tmp`;
+    try {
+      // eslint-disable-next-line no-await-in-loop
+      if ((await getPathReadAccessError(outPath)) == null) return outPath; // already repaired earlier
+      // eslint-disable-next-line no-await-in-loop
+      await copyFile(filePath, tmpPath);
+      // eslint-disable-next-line no-await-in-loop
+      const fd = await open(tmpPath, 'r+');
+      try {
+        // eslint-disable-next-line no-await-in-loop
+        await Promise.all(damagedBoxPositions.map(async (position) => fd.write(freeBoxType, 0, freeBoxType.length, position)));
+      } finally {
+        // eslint-disable-next-line no-await-in-loop
+        await fd.close();
+      }
+      // eslint-disable-next-line no-await-in-loop
+      await rename(tmpPath, outPath);
+      return outPath;
+    } catch (err) {
+      console.warn('Failed to create repaired copy in', outDir, err);
+      lastError = err;
+      // eslint-disable-next-line no-await-in-loop
+      await unlink(tmpPath).catch(() => undefined);
+    }
+  }
+  throw lastError;
+}
